# Copy to .env (chmod 600). Never commit .env.

# Telegram: the ONE bot that serves both tools (create it with @BotFather) and your chat id
# (send the bot a message, then run: .venv/bin/bw radar telegram-setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free AI providers for PUBLIC work (postings, ranking). Any may be empty: it is skipped.
# Private work (your messages and data) only ever runs on the local model (Ollama).
CEREBRAS_API_KEY=       # https://cloud.cerebras.ai
GROQ_API_KEY=           # https://console.groq.com
OPENROUTER_API_KEY=     # https://openrouter.ai
GEMINI_API_KEY=         # https://aistudio.google.com (its free tier may use what you send: public data only)

# Your university calendar feed (Brightspace/D2L: Calendar -> Subscribe)
D2L_ICS_URL=
